# Configurações do Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/dnd_manager
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Configurações de Segurança e JWT
# Segredo HMAC256 (recomenda-se chave segura com 256 bits ou mais)
JWT_SECRET=Y2hhdmUtc3VwZXItc2VjcmV0YS1wYXJhLWFzc2luYXR1cmEtZG8tamwtZDAuZmhrZGFzamtmaGFzZGZraGphc2Rm
# Tempo de expiração do token JWT em HORAS (ex: 2 para 2 horas, 24 para 24 horas)
JWT_EXPIRATION=2

# Configuração de CORS (URLs permitidas separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL da API externa para rolagem de dados/atributos de personagens
APIDADO_URL=http://localhost:8081/api/rolagens/atributos
